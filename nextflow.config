// 1. Define the dynamic run_code at the TOP level
params.run_code = "run_${new Date().format('yyyyMMdd')}_${UUID.randomUUID().toString()[0..7]}"

executor {
  queueGlobalStatus = true   // Allow jobs to run on different partitions
}
profiles {

  slurm {

    process {
      executor = 'slurm'
      time = { 1.hour * task.attempt }
      cpus = 8
      memory = { 64.GB * task.attempt }

      // Retry logic for specific exit codes
      errorStrategy = { 
        task.exitStatus in [143,137,104] && task.attempt <= 3 ? 'retry' : 'finish' 
      }
      maxRetries = 3

      withLabel: r {
        beforeScript = '''
          module load r/4.5.1
          export R_LIBS_USER=/nfs/research/ewald/softwares/R/x86_64-pc-linux-gnu-library/4.5
        '''
      }
      withLabel: gpu {
        cpus = 8
        memory = '64 GB'
        clusterOptions = '--gres=gpu:1' // request GPU
      }
    }
  }

  local {
    process.executor = 'local'
  }
}
