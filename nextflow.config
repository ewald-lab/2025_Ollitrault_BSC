profiles {

  slurm {

    process {
      executor = 'slurm'
      time = '2h'
      cpus = 8
      memory = '128 GB'

      withLabel: r {
        beforeScript = '''
          module load r/4.5.1
          export R_LIBS_USER=/nfs/research/ewald/softwares/R/x86_64-pc-linux-gnu-library/4.5
        '''
      }
    }
  }

  local {
    process.executor = 'local'
  }
}
